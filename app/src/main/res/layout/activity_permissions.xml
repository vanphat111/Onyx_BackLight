<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/app_padding"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="REQUIRED PERMISSIONS"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnReqRoot"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="1. GRANT ROOT ACCESS (KERNELSU)"
        android:backgroundTint="#444444"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnReqNotif"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="2. NOTIFICATION ACCESS"
        android:backgroundTint="#444444"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnReqBattery"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="3. DISABLE BATTERY SAVER"
        android:backgroundTint="#444444"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnReqAutoStart"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="4. ENABLE AUTO-START (HYPEROS)"
        android:backgroundTint="#444444"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnCheckAndContinue"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="CONTINUE"
        android:backgroundTint="#2196F3"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="App will exit if permissions are denied."
        android:textColor="#888888"
        android:textAlignment="center"
        android:layout_marginTop="16dp" />
</LinearLayout>