<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_permissions_screen"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_logo_orb"
                android:gravity="center"
                android:text="✦"
                android:textColor="#BDEBFF"
                android:textSize="27sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Onyx LED Controller"
                    android:textColor="#F6F8FF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="11dp"
            android:letterSpacing="0.08"
            android:text="REQUIRED PERMISSIONS"
            android:textColor="#8390AD"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReqNotif"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginBottom="12dp"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="1   Notification Access"
            android:textAlignment="viewStart"
            android:textAllCaps="false"
            android:textColor="#F4F7FF"
            android:textSize="16sp"
            app:backgroundTint="#202B47"
            app:cornerRadius="28dp"
            app:icon="@drawable/baseline_notifications_24"
            app:iconSize="24dp"
            app:iconGravity="end"
            app:iconPadding="20dp"
            app:iconTint="#FFF904"
            app:strokeColor="#526487"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReqBattery"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginBottom="12dp"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="2   Battery Optimization"
            android:textAlignment="viewStart"
            android:textAllCaps="false"
            android:textColor="#F4F7FF"
            android:textSize="16sp"
            app:backgroundTint="#202B47"
            app:cornerRadius="28dp"
            app:icon="@drawable/outline_battery_android_frame_full_24"
            app:iconSize="24dp"
            app:iconGravity="end"
            app:iconPadding="12dp"
            app:iconTint="#58BB38"
            app:strokeColor="#526487"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReqAutoStart"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginBottom="24dp"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="3   Enable Auto-start (Recommended)"
            android:textAlignment="viewStart"
            android:textAllCaps="false"
            android:textColor="#F4F7FF"
            android:textSize="16sp"
            app:backgroundTint="#202B47"
            app:cornerRadius="28dp"
            app:icon="@drawable/outline_bolt_24"
            app:iconSize="24dp"
            app:iconGravity="end"
            app:iconPadding="12dp"
            app:iconTint="#8FE3CE"
            app:strokeColor="#526487"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckAndContinue"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:text="Continue  →"
            android:textAllCaps="false"
            android:textColor="#11182B"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#91D7FF"
            app:cornerRadius="22dp"
            app:elevation="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="Granting permissions is required to run the app."
            android:textColor="#7F8BA5"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
