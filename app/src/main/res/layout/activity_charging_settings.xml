<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/app_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Charging LED Settings"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap any circle to change its color"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Low Battery (≤ 20%)"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <View android:id="@+id/low1" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle" android:layout_marginEnd="12dp"/>
            <View android:id="@+id/low2" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle" android:layout_marginEnd="12dp"/>
            <View android:id="@+id/low3" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle" android:layout_marginEnd="12dp"/>
            <View android:id="@+id/low4" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Charging (21% - 89%)"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <View android:id="@+id/med1" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle" android:layout_marginEnd="12dp"/>
            <View android:id="@+id/med2" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle" android:layout_marginEnd="12dp"/>
            <View android:id="@+id/med3" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle" android:layout_marginEnd="12dp"/>
            <View android:id="@+id/med4" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Battery (≥ 90%)"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">
            <View android:id="@+id/full1" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle" android:layout_marginEnd="12dp"/>
            <View android:id="@+id/full2" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle" android:layout_marginEnd="12dp"/>
            <View android:id="@+id/full3" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle" android:layout_marginEnd="12dp"/>
            <View android:id="@+id/full4" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle" />
        </LinearLayout>

        <TextView
            android:id="@+id/lblChargeBrightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Charging Brightness: 128"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
        <SeekBar
            android:id="@+id/seekChargeBrightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDemoCharge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Demo Effect"
                android:backgroundTint="@color/led_green"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnTurnOff"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Turn Off"
                android:backgroundTint="@color/led_red"
                android:textColor="@color/text_primary"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>